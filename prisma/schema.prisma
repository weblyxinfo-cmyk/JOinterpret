generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== BOOKING SYSTEM =====

enum BookingType {
  CLUB
  FESTIVAL
  PRIVATE
  CORPORATE
}

enum BookingStatus {
  NEW
  NEGOTIATING
  CONFIRMED
  COMPLETED
  REJECTED
}

model BookingRequest {
  id              String        @id @default(cuid())
  type            BookingType
  name            String
  email           String
  phone           String?
  eventDate       DateTime
  location        String?
  budget          String?
  description     String?
  briefFileUrl    String?
  status          BookingStatus @default(NEW)
  stripePaymentLink String?
  isPaid          Boolean       @default(false)
  addToReferences Boolean       @default(false)
  notes           BookingNote[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model BookingNote {
  id        String         @id @default(cuid())
  bookingId String
  booking   BookingRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  content   String
  author    String
  createdAt DateTime       @default(now())
}

// ===== VIP SYSTEM =====

enum VipType {
  MEET_GREET
  BACKSTAGE
}

enum VipStatus {
  PAID
  USED
  CANCELLED
  REFUNDED
}

model VipOrder {
  id              String    @id @default(cuid())
  type            VipType
  name            String
  email           String
  phone           String?
  concertId       String?
  persons         Int       @default(1)
  stripePaymentId String?
  status          VipStatus @default(PAID)
  qrCode          String?
  createdAt       DateTime  @default(now())
}

// ===== NEWSLETTER =====

model Subscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  source       String?
}

// ===== SETLIST VOTING =====

model SetlistVote {
  id         String   @id @default(cuid())
  songTitle  String
  eventId    String?
  voterHash  String
  createdAt  DateTime @default(now())

  @@unique([songTitle, eventId, voterHash])
}

// ===== ADMIN USER =====

model AdminUser {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String?
}

// ===== API STAT CACHE =====

model ApiStatCache {
  id        String   @id @default(cuid())
  service   String   // "spotify", "youtube"
  key       String   // "artist", "albums", "channel", "videos", "monthlyListeners"
  value     Json
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@unique([service, key])
}

// ===== SETLIST SONG POOL =====

model SetlistSong {
  id        String   @id @default(cuid())
  title     String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ===== SOCIAL LINKS =====

model SocialLink {
  id            String  @id @default(cuid())
  platform      String  @unique // "instagram", "tiktok", "youtube", "spotify", "podcast"
  url           String?
  followerCount String? // "50K+", "91K+" etc.
  isVisible     Boolean @default(true)
}

// ===== ALBUM / DISCOGRAPHY =====

model AlbumOverride {
  id         String  @id @default(cuid())
  spotifyId  String? @unique
  title      String
  year       String
  type       String  @default("ALBUM") // "ALBUM", "EP", "SINGLE", "ALBUM · LIVE"
  coverUrl   String?
  spotifyUrl String?
  sortOrder  Int     @default(0)
  isVisible  Boolean @default(true)
}
